  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login - Obtain JWT Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns a successful response', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.access) pm.collectionVariables.set('access_token', body.access);",
                  "  if (body.refresh) pm.collectionVariables.set('refresh_token', body.refresh);",
                  "  pm.test('Access token received', function () { pm.expect(body.access).to.be.a('string').and.not.empty; });",
                  "  pm.test('Refresh token received', function () { pm.expect(body.refresh).to.be.a('string').and.not.empty; });",
                  "} else { console.log('Login failed. Check credentials and backend logs.'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts/login/",
            "description": "Replace the collection variables username and password with valid HR/Admin credentials."
          },
          "response": []
        },
        {
          "name": "Get Current User Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile request succeeds', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Profile has a username', function () { pm.expect(body.username).to.be.a('string'); });",
                  "  console.log('Current user:', body.username, 'Role:', body.role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/accounts/me/",
            "description": "Expected: current authenticated user's profile, including username and role if exposed by the serializer."
          },
          "response": []
        },
        {
          "name": "Refresh JWT Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh endpoint returns success', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.access) pm.collectionVariables.set('access_token', body.access);",
                  "  pm.test('New access token received', function () { pm.expect(body.access).to.be.a('string').and.not.empty; });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
